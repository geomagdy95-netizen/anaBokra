# Read by the Supabase CLI (supabase start). Copy to supabase/.env (git-ignored).
# Must equal SEND_SMS_HOOK_SECRETS in apps/web/.env.local. Generate: echo "v1,whsec_$(openssl rand -base64 32)"
SEND_SMS_HOOK_SECRETS=
# Google OAuth client (Google Cloud > Credentials > OAuth client ID, Web application).
# Dummy values let the stack boot; Google sign-in only works with real ones.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
