# anaBokra web app environment. Copy to .env.local (never commit real values).

# ---------------------------------------------------------------- Supabase
# Local stack: run `supabase start` and copy the values it prints (`supabase status -o env`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Public (anon / publishable) key. Safe for the browser; protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET. Bypasses RLS. Server only (profile bootstrap after login). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- Auth hook (WhatsApp OTP)
# Shared secret used by Supabase Auth to sign calls to POST /api/auth/hooks/send-sms
# (standard-webhooks). Format: v1,whsec_<base64>. Generate one with:
#   echo "v1,whsec_$(openssl rand -base64 32)"
# The SAME value must be visible to the Supabase Auth container (supabase/config.toml reads it
# from the environment as env(SEND_SMS_HOOK_SECRETS); for the local CLI put it in supabase/.env).
SEND_SMS_HOOK_SECRETS=

# Which adapter delivers the code: console | openwa | whatsappCloud
# Default: console outside production. In production this MUST be set (console is refused).
OTP_SENDER=console

# --- openwa: open-wa EASY API server running as a SEPARATE container (not inside Next)
# OPENWA_URL=http://openwa:8002
# OPENWA_API_KEY=            # optional, the --key you started open-wa with (sent as `api_key` header)

# --- whatsappCloud: Meta WhatsApp Business Cloud API, AUTHENTICATION template approved in `ar` and `en`
# (body {{1}} = code, with a copy-code button)
# WHATSAPP_CLOUD_TOKEN=               # permanent system-user access token
# WHATSAPP_CLOUD_PHONE_NUMBER_ID=     # sender phone number ID (not the number itself)
# WHATSAPP_CLOUD_TEMPLATE_NAME=       # e.g. anabokra_otp
# WHATSAPP_CLOUD_API_VERSION=v23.0    # optional
# Consent notices (MX-13) are UTILITY templates approved in `ar` and `en`; body {{1}}.. in the order of
# NoticeMessage.params (see src/server/consent/notices.ts). openwa/console send the rendered text instead.
# WHATSAPP_CLOUD_TEMPLATE_CONSENT_INVITE=anabokra_consent_invite     # {{1}} teen nickname, {{2}} link
# WHATSAPP_CLOUD_TEMPLATE_CHILD_CLAIM=anabokra_child_claim           # {{1}} parent name, {{2}} link
# WHATSAPP_CLOUD_TEMPLATE_CONSENT_GRANTED=anabokra_consent_granted   # {{1}} teen nickname, {{2}} date, {{3}} link
# WHATSAPP_CLOUD_TEMPLATE_CONSENT_WITHDRAWN=anabokra_consent_withdrawn  # {{1}} teen nickname, {{2}} date

# ---------------------------------------------------------------- Rate limits (all optional)
# Codes sent per phone/email per hour (checked in /api/auth/otp/request AND again in the hook)
# OTP_RATE_LIMIT_PHONE_PER_HOUR=5
# Code requests per client IP per hour (behind a reverse proxy that sets x-forwarded-for)
# OTP_RATE_LIMIT_IP_PER_HOUR=20
# Code-guess attempts per phone/email and per IP, per 15 minutes
# OTP_VERIFY_LIMIT_PER_15_MIN=10
# OTP_VERIFY_IP_LIMIT_PER_15_MIN=40

# ---------------------------------------------------------------- Read by the Supabase CLI / Auth container, not by Next
# Google sign-in (Google Cloud console > OAuth client, type "Web application").
# Authorized redirect URI: <SUPABASE_URL>/auth/v1/callback  (local: http://127.0.0.1:54321/auth/v1/callback)
# Put these in supabase/.env locally, or in the Auth container env when self-hosting.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ---------------------------------------------------------------- Careers (SEO)
# Public origin used for canonical and hreflang URLs on career pages, e.g. https://anabokra.app
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------- Support
# Address used by "report an issue" links (default support@anabokra.app)
# NEXT_PUBLIC_SUPPORT_EMAIL=support@anabokra.app

# ---------------------------------------------------------------- Consent flows (MX-13)
# Public origin used inside WhatsApp links (https://anabokra.app/ar/consent/<token>). Falls back to the request origin.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Dev only: fake signed-in student + in-memory consent store, no Supabase. The parent's OTP is "123456".
# ASSESSMENT_REPO=memory
# ASSESSMENT_MOCK_NEEDS_CONSENT=1      # start the mock student as a minor WITHOUT consent (default: already consented)
# Per-student limits (optional)
# CONSENT_MAX_RESENDS_PER_DAY=3
