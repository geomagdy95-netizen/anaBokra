    "items": ["ipip_E01", "ipip_E07", "ipip_E02", "ipip_E04", "ipip_A04", "ipip_A08", "ipip_A09", "ipip_A05", "ipip_C05", "ipip_C07", "ipip_C06", "ipip_C04", "ipip_N08", "ipip_N06", "ipip_N02", "ipip_N04", "ipip_O03", "ipip_O04", "ipip_O02", "ipip_O06"]
  },
  "items": [
    { "id": "ipip_E01", "scale": "extraversion", "keyed": 1, "text": { "en": "Am the life of the party.", "ar": "بكون مصدر الحيوية والبهجة في التجمعات" } },
    { "id": "ipip_A01", "scale": "agreeableness", "keyed": -1, "text": { "en": "Feel little concern for others.", "ar": "نادرًا ما بهتم بأمر الناس" } },
    { "id": "ipip_C01", "scale": "conscientiousness", "keyed": 1, "text": { "en": "Am always prepared.", "ar": "دايمًا بكون مستعد", "arF": "دايمًا بكون مستعدة" } },
    { "id": "ipip_N01", "scale": "emotionalStability", "keyed": -1, "text": { "en": "Get stressed out easily.", "ar": "بتوتر بسهولة" } },
    { "id": "ipip_O01", "scale": "intellect", "keyed": 1, "text": { "en": "Have a rich vocabulary.", "ar": "عندي حصيلة كلمات كبيرة" } },
    { "id": "ipip_E02", "scale": "extraversion", "keyed": -1, "text": { "en": "Don't talk a lot.", "ar": "مش بتكلم كتير" } },
    { "id": "ipip_A02", "scale": "agreeableness", "keyed": 1, "text": { "en": "Am interested in people.", "ar": "بهتم بالناس" } },
    { "id": "ipip_C02", "scale": "conscientiousness", "keyed": -1, "text": { "en": "Leave my belongings around.", "ar": "بسيب حاجتي في كل حتة" } },
    { "id": "ipip_N02", "scale": "emotionalStability", "keyed": 1, "text": { "en": "Am relaxed most of the time.", "ar": "بكون هادي أغلب الوقت", "arF": "بكون هادية أغلب الوقت" } },
    { "id": "ipip_O02", "scale": "intellect", "keyed": -1, "text": { "en": "Have difficulty understanding abstract ideas.", "ar": "بلاقي صعوبة في فهم الأفكار المجردة" } },
    { "id": "ipip_E03", "scale": "extraversion", "keyed": 1, "text": { "en": "Feel comfortable around people.", "ar": "بحس بالراحة وسط الناس" } },
    { "id": "ipip_A03", "scale": "agreeableness", "keyed": -1, "text": { "en": "Insult people.", "ar": "بجرح الناس بكلامي" } },
    { "id": "ipip_C03", "scale": "conscientiousness", "keyed": 1, "text": { "en": "Pay attention to details.", "ar": "بخلي بالي من التفاصيل" } },
    { "id": "ipip_N03", "scale": "emotionalStability", "keyed": -1, "text": { "en": "Worry about things.", "ar": "بقلق على حاجات كتير" } },
    { "id": "ipip_O03", "scale": "intellect", "keyed": 1, "text": { "en": "Have a vivid imagination.", "ar": "عندي خيال واسع" } },
    { "id": "ipip_E04", "scale": "extraversion", "keyed": -1, "text": { "en": "Keep in the background.", "ar": "بفضّل أفضل بعيد عن الأضواء" } },
    { "id": "ipip_A04", "scale": "agreeableness", "keyed": 1, "text": { "en": "Sympathize with others' feelings.", "ar": "بتعاطف مع مشاعر الناس" } },
    { "id": "ipip_C04", "scale": "conscientiousness", "keyed": -1, "text": { "en": "Make a mess of things.", "ar": "بعمل لخبطة في الحاجات" } },
    { "id": "ipip_N04", "scale": "emotionalStability", "keyed": 1, "text": { "en": "Seldom feel blue.", "ar": "نادرًا ما بحس بالحزن" } },
    { "id": "ipip_O04", "scale": "intellect", "keyed": -1, "text": { "en": "Am not interested in abstract ideas.", "ar": "مش مهتم بالأفكار المجردة", "arF": "مش مهتمة بالأفكار المجردة" } },
    { "id": "ipip_E05", "scale": "extraversion", "keyed": 1, "text": { "en": "Start conversations.", "ar": "ببدأ أنا الكلام" } },
    { "id": "ipip_A05", "scale": "agreeableness", "keyed": -1, "text": { "en": "Am not interested in other people's problems.", "ar": "مشاكل الناس مش بتفرق معايا" } },
    { "id": "ipip_C05", "scale": "conscientiousness", "keyed": 1, "text": { "en": "Get chores done right away.", "ar": "بخلّص المطلوب مني على طول" } },
    { "id": "ipip_N05", "scale": "emotionalStability", "keyed": -1, "text": { "en": "Am easily disturbed.", "ar": "بنزعج بسهولة" } },
    { "id": "ipip_O05", "scale": "intellect", "keyed": 1, "text": { "en": "Have excellent ideas.", "ar": "عندي أفكار ممتازة" } },
    { "id": "ipip_E06", "scale": "extraversion", "keyed": -1, "text": { "en": "Have little to say.", "ar": "مبيبقاش عندي كلام كتير أقوله" } },
    { "id": "ipip_A06", "scale": "agreeableness", "keyed": 1, "text": { "en": "Have a soft heart.", "ar": "قلبي طيب" } },
    { "id": "ipip_C06", "scale": "conscientiousness", "keyed": -1, "text": { "en": "Often forget to put things back in their proper place.", "ar": "كتير بنسى أرجّع الحاجة مكانها" } },
    { "id": "ipip_N06", "scale": "emotionalStability", "keyed": -1, "text": { "en": "Get upset easily.", "ar": "بتضايق بسهولة" } },
    { "id": "ipip_O06", "scale": "intellect", "keyed": -1, "text": { "en": "Do not have a good imagination.", "ar": "خيالي مش قوي" } },

    { "id": "ipip_ac1", "text": { "en": "Quick check: choose \"Moderately inaccurate\" for this one", "ar": "سؤال سريع: اختار «مش بيوصفني» هنا", "arF": "سؤال سريع: اختاري «مش بيوصفني» هنا" }, "attentionCheck": { "expected": 2 } },

    { "id": "ipip_E07", "scale": "extraversion", "keyed": 1, "text": { "en": "Talk to a lot of different people at parties.", "ar": "بتكلم مع ناس كتير ومختلفة في المناسبات" } },
    { "id": "ipip_A07", "scale": "agreeableness", "keyed": 1, "text": { "en": "Take time out for others.", "ar": "بخصص وقت للناس اللي حواليا" } },
    { "id": "ipip_C07", "scale": "conscientiousness", "keyed": 1, "text": { "en": "Like order.", "ar": "بحب النظام" } },
    { "id": "ipip_N07", "scale": "emotionalStability", "keyed": -1, "text": { "en": "Change my mood a lot.", "ar": "مزاجي بيتغير كتير" } },
    { "id": "ipip_O07", "scale": "intellect", "keyed": 1, "text": { "en": "Am quick to understand things.", "ar": "بفهم بسرعة" } },
    { "id": "ipip_E08", "scale": "extraversion", "keyed": -1, "text": { "en": "Don't like to draw attention to myself.", "ar": "مش بحب ألفت الانتباه ليا" } },
    { "id": "ipip_A08", "scale": "agreeableness", "keyed": 1, "text": { "en": "Feel others' emotions.", "ar": "بحس بمشاعر اللي حواليا" } },
    { "id": "ipip_C08", "scale": "conscientiousness", "keyed": -1, "text": { "en": "Shirk my duties.", "ar": "بتهرب من مسؤولياتي" } },
    { "id": "ipip_N08", "scale": "emotionalStability", "keyed": -1, "text": { "en": "Have frequent mood swings.", "ar": "عندي تقلبات مزاجية كتير" } },
    { "id": "ipip_O08", "scale": "intellect", "keyed": 1, "text": { "en": "Use difficult words.", "ar": "بستخدم كلمات صعبة" } },
    { "id": "ipip_E09", "scale": "extraversion", "keyed": 1, "text": { "en": "Don't mind being the center of attention.", "ar": "مش بيضايقني أكون محور الاهتمام" } },
    { "id": "ipip_A09", "scale": "agreeableness", "keyed": -1, "text": { "en": "Am not really interested in others.", "ar": "مش مهتم أوي بالآخرين", "arF": "مش مهتمة أوي بالآخرين" } },
    { "id": "ipip_C09", "scale": "conscientiousness", "keyed": 1, "text": { "en": "Follow a schedule.", "ar": "بمشي على جدول" } },
    { "id": "ipip_N09", "scale": "emotionalStability", "keyed": -1, "text": { "en": "Get irritated easily.", "ar": "بتعصب بسهولة" } },
    { "id": "ipip_O09", "scale": "intellect", "keyed": 1, "text": { "en": "Spend time reflecting on things.", "ar": "بقضي وقت أفكر وأتأمل في الحاجات" } },
    { "id": "ipip_E10", "scale": "extraversion", "keyed": -1, "text": { "en": "Am quiet around strangers.", "ar": "بكون هادي مع الناس اللي معرفهمش", "arF": "بكون هادية مع الناس اللي معرفهمش" } },
    { "id": "ipip_A10", "scale": "agreeableness", "keyed": 1, "text": { "en": "Make people feel at ease.", "ar": "بخلي الناس تحس بالراحة" } },
    { "id": "ipip_C10", "scale": "conscientiousness", "keyed": 1, "text": { "en": "Am exacting in my work.", "ar": "بكون دقيق جدًا في شغلي", "arF": "بكون دقيقة جدًا في شغلي" } },
    { "id": "ipip_N10", "scale": "emotionalStability", "keyed": -1, "text": { "en": "Often feel blue.", "ar": "كتير بحس بالحزن" } },
    { "id": "ipip_O10", "scale": "intellect", "keyed": 1, "text": { "en": "Am full of ideas.", "ar": "دماغي مليانة أفكار" } }
  ]
}
