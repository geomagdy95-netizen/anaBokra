{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anabokra.app/schemas/universities.schema.json",
  "title": "anaBokra universities dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "asOf",
    "sources",
    "universities"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "asOf": {
      "type": "string",
      "format": "date"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "url"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        }
      }
    },
    "universities": {
      "type": "array",
      "minItems": 100,
      "items": {
        "$ref": "#/$defs/university"
      }
    }
  },
  "$defs": {
    "university": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "governorate",
        "city",
        "website",
        "established",
        "sourceUrl",
        "verifiedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "en",
            "ar"
          ],
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1
            },
            "ar": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "type": {
          "enum": [
            "public",
            "private",
            "national",
            "technological",
            "international_branch",
            "azhar",
            "other"
          ]
        },
        "governorate": {
          "enum": [
            "Alexandria",
            "Assiut",
            "Aswan",
            "Beheira",
            "Beni Suef",
            "Cairo",
            "Dakahlia",
            "Damietta",
            "Fayoum",
            "Gharbia",
            "Giza",
            "Ismailia",
            "Kafr El Sheikh",
            "Luxor",
            "Matrouh",
            "Menoufia",
            "Minya",
            "New Valley",
            "North Sinai",
            "Port Said",
            "Qalyubia",
            "Qena",
            "Red Sea",
            "Sharqia",
            "Sohag",
            "South Sinai",
            "Suez"
          ]
        },
        "city": {
          "type": "string",
          "minLength": 1
        },
        "website": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            {
              "type": "null"
            }
          ]
        },
        "established": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 900,
              "maximum": 2100
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "verifiedAt": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
